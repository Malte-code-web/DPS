{
  "name": "dps",
  "private": true,
  "version": "0.8.0",
  "description": "Dynamische Patienten-Simulation zum Üben von MANV-Lagen",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode einzeldatei && node scripts/build-single-file.mjs",
    "anker": "node scripts/anker.mjs",
    "anker:pruefen": "node scripts/anker.mjs --pruefen",
    "lint": "oxlint",
    "test": "vitest run",
    "ki:test": "vitest run kiClient.live --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.111.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "taktische-zeichen-core": "^0.10.0",
    "taktische-zeichen-react": "^0.10.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
